    "history:verify": "node scripts/verify-history-journal.mjs && node scripts/verify-history-controls-controller.mjs && node scripts/verify-history-retention.mjs",
    "layers:verify": "node scripts/verify-layer-panel-controller.mjs && node scripts/verify-layer-thumbnail-controller.mjs && node scripts/verify-scene-editor-controller.mjs && node scripts/verify-layer-stack.mjs",
