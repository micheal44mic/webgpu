  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@webgpu/types": "0.1.71",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-18",
    "earcut": "^3.0.2",
    "lucide": "^1.28.0",
    "opentype.js": "^1.3.4"
