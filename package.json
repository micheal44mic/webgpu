    "governor:verify": "node scripts/verify-memory-governor.mjs",
    "bevel:verify": "node scripts/verify-bevel-core.mjs",
    "shadow:verify": "node scripts/verify-shadow-core.mjs",
    "view:verify": "node scripts/verify-view-rotation.mjs",
    "compression:verify": "node scripts/verify-layer-compression.mjs",
    "vector-text:verify": "node scripts/verify-vector-text.mjs",
    "vector-shadow:verify": "node scripts/verify-vector-shadow-3d.mjs",
    "mixed-scene:verify": "node scripts/verify-mixed-scene-stack.mjs",
    "image:verify": "node scripts/verify-raster-image.mjs",
    "transform:verify": "node scripts/verify-raster-transform.mjs",
    "gaussian-blur:verify": "node scripts/verify-gaussian-blur.mjs",
    "motion-blur:verify": "node scripts/verify-motion-blur.mjs && node scripts/verify-motion-blur-ui.mjs",
    "noise:verify": "node scripts/verify-noise.mjs",
    "noise-mip:verify": "node scripts/verify-noise-mip-smoothing.mjs",
    "layer-thumbnails:verify": "node scripts/verify-layer-thumbnail-controller.mjs && node scripts/verify-restored-layer-thumbnails.mjs",
    "liquify:verify": "node scripts/verify-liquify.mjs",
    "raster-filters:verify": "npm run gaussian-blur:verify && npm run motion-blur:verify && npm run noise:verify && npm run liquify:verify && npm run precision:verify"
